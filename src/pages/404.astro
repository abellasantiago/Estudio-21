---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Página no encontrada — Estudio 21"
  description="La página que buscás no existe o se movió."
>
  <section class="block">
    <div class="wrap">
      <span class="eyebrow">Error 404</span>
      <h2 class="section-title">Esta página no existe.</h2>
      <p class="lead">Puede que el enlace esté roto o que la página se haya movido.</p>
      <p class="back-home">
        <a class="btn btn--primary" href={`${base}/`}>
          <span class="btn-arrow btn-arrow--back" aria-hidden="true">←</span>Volver al inicio
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* El botón es el primitivo `.btn` de global.css; acá sólo su ubicación. */
  .back-home {
    margin-top: 2.4rem;
  }
</style>
