---
import BaseLayout from '../layouts/BaseLayout.astro';
import LivingBackground from '../components/LivingBackground.astro';
import ProgressRail from '../components/ProgressRail.astro';
import Hero from '../components/sections/Hero.astro';
import Presentacion from '../components/sections/Presentacion.astro';
import Nosotros from '../components/sections/Nosotros.astro';
import ProyectosHelicoidal from '../components/ProyectosHelicoidal.astro';
import Estudio from '../components/sections/Estudio.astro';
import Contacto from '../components/sections/Contacto.astro';
import { site } from '../data/site';

const title = 'Estudio 21 — Arquitectura y desarrollo · Montevideo';
const description = site.descripcion;
---

<BaseLayout title={title} description={description} immersive>
  <!-- fondo vivo continuo (hero → quiénes somos → proyectos → cómo operamos =
       un mismo espacio, hasta que Equipo lo tapa) -->
  <LivingBackground />
  <ProgressRail />

  {/* El orden responde las preguntas de quien llega, en el orden en que se las
      hace: qué es esto (Quiénes somos), qué hicieron (Proyectos), cómo se
      trabaja con ellos (Cómo operamos), quiénes son (Equipo) y cómo los
      contacto. La prueba va ANTES que el proceso: leídas después de diez obras,
      las cuatro fases explican cómo se hicieron; leídas antes, son una promesa.
      Ver "Home — secciones" en CLAUDE.md. */}
  {/* Cada sección se separa de la siguiente por el TONO del papel (ver "los
      tres papeles" en global.css): Quiénes somos y Cómo operamos sobre el papel
      abierto, Proyectos sobre la mesa —un punto más honda— entre las dos,
      Equipo un punto más claro y Contacto en tinta. Ninguna queda pegada a otra
      del mismo tono, así que no hacen falta reglas divisorias. El hero y Quiénes
      somos sí comparten papel: son el mismo espacio. */}
  <Hero />
  <Presentacion />
  <ProyectosHelicoidal />
  <Nosotros />
  <Estudio />
  <Contacto />
</BaseLayout>
