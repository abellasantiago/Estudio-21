---
/*
 * Galería del proyecto: tira horizontal de miniaturas + visor a pantalla completa.
 *
 * Tira: todas las miniaturas al MISMO ALTO y con el ANCHO que les corresponde
 * por su proporción real (tipo tira de contactos) → ninguna foto se recorta.
 * Las fotos del estudio van de 0.56 (vertical de celular) a 1.95 (panorámica),
 * así que cualquier caja fija recortaría fuerte a la mitad del material.
 * Scrollea sola en horizontal; el script agrega arrastrar con el mouse y los
 * degradés de borde que avisan que hay más.
 *
 * Visor: la foto grande sobre un velo de papel translúcido + blur — el sitio se
 * sigue viendo detrás, no es un fondo negro opaco. Anterior/siguiente con los
 * botones, con las flechas del teclado y en ciclo (de la última vuelve a la
 * primera). Escape o click afuera cierran.
 *
 * Sin JS sigue sirviendo: cada miniatura es un <a> a la foto grande.
 */
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/galeria.css';

interface Props {
  fotos: ImageMetadata[];
  nombre: string;
  slug: string;
}

const { fotos, nombre, slug } = Astro.props;

/*
 * La tira mide `--gal-h` de alto (galeria.css) y de ahí sale el ancho de cada
 * miniatura: su proporción real × ese alto. Pero `--gal-h` NO es un número
 * fijo, es `clamp(150px, 22vh, 240px)`: vale 150 hasta 682px de alto de
 * ventana (150/0,22), 240 desde 1091 (240/0,22), y 22vh en el medio.
 *
 * ⚠ Por eso el `sizes` lleva un `calc(... * 22vh)` y no un número de píxeles.
 * Acá había `TIRA_H = 168` —el valor de un clamp anterior— declarado como
 * `sizes="252px"` para TODA pantalla: como el hueco real va de 150 a 240, eso
 * es declarar de más casi siempre, y el navegador bajaba el escalón de 2×
 * (504px) incluso en una ventana donde el hueco medía 154. Declarar en cambio
 * el máximo fijo (240) es todavía peor: en la ventana de 900px de alto que es
 * la más común, el hueco mide 198 y se pediría como si midiera 240.
 * Con el `calc` el navegador sabe el alto exacto y elige el escalón justo; los
 * dos tramos planos del clamp van como condiciones de media delante.
 *
 * ⚠ Estos números tienen que coincidir con el clamp de `--gal-h` en
 * galeria.css. Si allá cambia el 22vh o los topes, acá también.
 */
const TIRA_H_MIN = 150;
const TIRA_H_MAX = 240;
const TIRA_VH_PCT = 22;
const TIRA_VH_BAJO = Math.round(TIRA_H_MIN / (TIRA_VH_PCT / 100)); // 682
const TIRA_VH_ALTO = Math.round(TIRA_H_MAX / (TIRA_VH_PCT / 100)); // 1091

/* Los altos que hay que cubrir: los dos topes del clamp en 1×, y el recorrido
   entero en 2× y 3×. Con estos escalones el navegador siempre encuentra uno
   que cubre el hueco real sin pasarse mucho. */
const TIRA_ESCALONES = [TIRA_H_MIN, TIRA_H_MAX, TIRA_H_MIN * 2, TIRA_H_MAX * 2, TIRA_H_MAX * 3];

/* Calidad del avif del visor. Medida contra el webp q82 que ya se servía: a
   1800px de ancho da 416 KB contra 533, o sea un 22% menos, con SSIM apenas
   MEJOR (0,9722 contra 0,9713). Bajar a q55 daría un 38% menos pero ahí el
   SSIM cae un 1,2%, y el visor es justo donde alguien está mirando la obra de
   cerca: no es el lugar para ahorrar. */
const VISOR_AVIF_Q = 62;

const items = await Promise.all(
  fotos.map(async (img) => {
    const ar = img.width / img.height;
    const anchoDe = (alto: number) => Math.max(60, Math.round(alto * ar));
    const ancho = anchoDe(TIRA_H_MIN);
    const anchoMax = anchoDe(TIRA_H_MAX);
    return {
      img,
      ar,
      ancho,
      anchoMax,
      anchos: [...new Set(TIRA_ESCALONES.map((h) => Math.min(anchoDe(h), img.width)))].sort((a, b) => a - b),
      /*
       * Versión grande para el visor: se genera en build pero no se descarga
       * hasta abrirla (el <img> del visor recibe el src recién al abrir).
       *
       * Se emiten las DOS: el webp es el `href` del <a> —o sea lo que abre un
       * navegador sin JS, y el fallback universal— y el avif es lo que el
       * script le pasa al visor si el navegador lo soporta. A casi resolución
       * completa esta es la descarga más pesada del sitio, y el avif le saca un
       * 22%; va aparte y no como `<source>` de un <picture> porque el visor
       * precarga las dos fotos vecinas con `new Image()`, y hay que precargar
       * el MISMO archivo que después se va a mostrar.
       */
      grande: await getImage({
        src: img,
        width: Math.min(img.width, 1800),
        format: 'webp',
        quality: 82,
      }),
      grandeAvif: await getImage({
        src: img,
        width: Math.min(img.width, 1800),
        format: 'avif',
        quality: VISOR_AVIF_Q,
      }),
    };
  }),
);

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="galeria" aria-label="Galería de fotos">
  <div class="gal-head">
    <span class="eyebrow">Galería</span>
    {fotos.length > 0 && <p class="gal-count" aria-hidden="true">{pad(fotos.length)} fotos</p>}
  </div>

  {fotos.length > 0 ? (
    <div class="gal-strip-wrap">
      <ul class="gal-strip" id="galStrip">
        {items.map((it, i) => (
          <li>
            <a
              class="gal-item"
              href={it.grande.src}
              data-avif={it.grandeAvif.src}
              style={`--ar:${it.img.width}/${it.img.height}`}
              data-w={it.img.width}
              data-h={it.img.height}
              aria-label={`Ampliar foto ${i + 1} de ${fotos.length}`}
            >
              {/* fallbackFormat: ver el porqué en ProjectLayout */}
              <Picture
                src={it.img}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                alt={`${nombre} — foto ${i + 1}`}
                widths={it.anchos}
                sizes={`(max-height: ${TIRA_VH_BAJO}px) ${it.ancho}px, (min-height: ${TIRA_VH_ALTO}px) ${it.anchoMax}px, calc(${it.ar.toFixed(4)} * ${TIRA_VH_PCT}vh)`}
                loading="lazy"
              />
            </a>
          </li>
        ))}
      </ul>

      {/* flechitas sobre las miniaturas de los extremos: desplazan la tira sin
          tener que ir hasta la barra de scroll. Sólo aparecen del lado donde
          todavía queda algo por ver (lo maneja el script). */}
      <button type="button" class="gal-arrow prev" data-gal-scroll="-1" aria-label="Ver fotos anteriores">
        <svg viewBox="0 0 10 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M8.5 1 1.5 8l7 7" />
        </svg>
      </button>
      <button type="button" class="gal-arrow next" data-gal-scroll="1" aria-label="Ver más fotos">
        <svg viewBox="0 0 10 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M1.5 1l7 7-7 7" />
        </svg>
      </button>
    </div>
  ) : (
    <p class="galeria-empty">
      Galería pendiente · tirá las fotos en src/assets/proyectos/{slug}/
    </p>
  )}
</section>

{fotos.length > 0 && (
  <div class="lbox" id="galLbox" hidden>
    <div class="lbox-veil" data-gal-close></div>
    <div class="lbox-panel" role="dialog" aria-modal="true" aria-label="Foto ampliada" tabindex="-1">
      <img class="lbox-img" data-gal-img alt="" />

      <div class="lbox-bar">
        <button type="button" class="lbox-btn" data-gal-prev aria-label="Foto anterior">
          <svg viewBox="0 0 10 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8.5 1 1.5 8l7 7" />
          </svg>
        </button>
        <p class="lbox-counter">
          <span data-gal-i>01</span><span class="lbox-sep">/</span><span>{pad(fotos.length)}</span>
        </p>
        <button type="button" class="lbox-btn" data-gal-next aria-label="Foto siguiente">
          <svg viewBox="0 0 10 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1.5 1l7 7-7 7" />
          </svg>
        </button>
      </div>

      <button type="button" class="lbox-close" data-gal-close aria-label="Cerrar la foto">
        <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M1 1l12 12M13 1L1 13" />
        </svg>
      </button>
    </div>
  </div>
)}

<script>
  const strip = document.getElementById('galStrip');
  const lbox = document.getElementById('galLbox');

  if (strip && lbox) {
    const items = Array.from(strip.querySelectorAll<HTMLAnchorElement>('.gal-item'));
    const wrap = strip.parentElement;
    const visor = lbox.querySelector<HTMLImageElement>('[data-gal-img]');
    const panel = lbox.querySelector<HTMLElement>('.lbox-panel');
    const idxEl = lbox.querySelector<HTMLElement>('[data-gal-i]');
    const root = document.documentElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const pad = (n: number) => String(n).padStart(2, '0');

    /*
     * El visor muestra avif donde se pueda y webp donde no. El `href` del <a>
     * se queda en webp (es el fallback universal y lo que abre un navegador sin
     * JS), así que la elección se hace acá, en un solo lugar: `url()`.
     *
     * No alcanza con mirar el `<source type="image/avif">` de un <picture>
     * porque el visor PRECARGA las vecinas con `new Image()`, y precargar el
     * webp para después mostrar el avif duplicaría la descarga. La sonda es un
     * avif de 1px: hasta que carga, `url()` devuelve webp — que es correcto, y
     * lo único que pasa si alguien hace click en el primer instante es que esa
     * foto baja en webp.
     *
     * ⚠ El base64 es un AVIF de verdad, generado con sharp
     * (`sharp({create:{width:1,height:1,channels:3}}).avif()`). Acá hubo una
     * sonda copiada de memoria que era un AVIF MAL ARMADO: el navegador tiraba
     * `onerror`, `avifOk` se quedaba en false para siempre y el visor servía
     * webp a todo el mundo, en silencio y sin romperse. Si hay que tocarla,
     * generar el archivo y verificar en un navegador que el visor baje `.avif`.
     */
    let avifOk = false;
    const sonda = new Image();
    sonda.onload = () => {
      avifOk = sonda.width === 1;
    };
    sonda.src =
      'data:image/avif;base64,';

    /** La URL que hay que bajar para la foto de este <a>. */
    const url = (a: HTMLAnchorElement) => (avifOk && a.dataset.avif) || a.href;

    let cur = -1;
    let opener: HTMLElement | null = null;
    let hideTimer = 0;

    // ---- visor ---------------------------------------------------------------
    /** Muestra la foto `i` (en ciclo: de la última pasa a la primera y al revés). */
    function show(i: number) {
      const n = items.length;
      if (!n) return;
      cur = ((i % n) + n) % n;
      const a = items[cur];

      if (visor) {
        // width/height reales → el visor reserva el lugar y la foto no salta
        visor.width = Number(a.dataset.w) || 0;
        visor.height = Number(a.dataset.h) || 0;
        visor.src = url(a);
        visor.alt = a.querySelector('img')?.alt ?? '';
      }
      if (idxEl) idxEl.textContent = pad(cur + 1);

      // precargar las vecinas → pasar de foto es instantáneo
      for (const d of [1, -1]) {
        const pre = new Image();
        pre.src = url(items[((cur + d) % n + n) % n]);
      }

      // acompañar con la tira: la miniatura de la foto abierta queda a la vista
      items.forEach((el, k) => el.classList.toggle('is-active', k === cur));
      a.scrollIntoView({
        block: 'nearest',
        inline: 'nearest',
        behavior: reduce.matches ? 'auto' : 'smooth',
      });
    }

    // ---- la miniatura crece hasta el visor (y vuelve a su lugar al cerrar) ----
    // Misma técnica que la foto que viaja de la card a la ficha, pero dentro de
    // la página: `startViewTransition` saca una foto del estado actual, se abre
    // (o cierra) el visor, y el navegador anima la miniatura hasta la foto
    // grande. Sin soporte o con menos movimiento, el fundido de siempre.
    const conVT = () =>
      'startViewTransition' in document && !reduce.matches && !document.hidden;
    let vtCorriendo = false;

    function transicion(cambio: () => void, desde: HTMLElement | null, hasta: () => HTMLElement | null) {
      vtCorriendo = true;
      root.classList.add('vt-galeria');
      if (desde) desde.style.viewTransitionName = 'gal-foto';
      let destino: HTMLElement | null = null;
      const t = document.startViewTransition(() => {
        if (desde) desde.style.viewTransitionName = '';
        cambio();
        destino = hasta();
        if (destino) destino.style.viewTransitionName = 'gal-foto';
      });
      t.finished.finally(() => {
        if (destino) destino.style.viewTransitionName = '';
        root.classList.remove('vt-galeria');
        vtCorriendo = false;
      });
    }

    /** ¿La miniatura se ve entera dentro de la tira? (si no, no hay adónde volver) */
    const miniaturaALaVista = (a: HTMLElement) => {
      const r = a.getBoundingClientRect();
      const t = strip!.getBoundingClientRect();
      return r.width > 0 && r.left >= t.left - 1 && r.right <= t.right + 1 && r.bottom > 0 && r.top < innerHeight;
    };

    function abrirVisor(i: number) {
      lbox!.hidden = false;
      root.classList.add('gal-open'); // bloquea el scroll de la página
      show(i);
    }

    function open(i: number, desde: HTMLElement | null) {
      if (vtCorriendo) return;
      clearTimeout(hideTimer);
      opener = desde;
      if (conVT() && desde) {
        // La foto grande se pide y se decodifica ANTES de arrancar (con un tope
        // corto, para que el click no se sienta lento): así llega al visor ya
        // pintada y no se funde contra un recuadro vacío. La vista de destino
        // igual es "en vivo": si tarda más, aparece durante el viaje.
        vtCorriendo = true;
        const pre = new Image();
        pre.src = url(items[((i % items.length) + items.length) % items.length]);
        const lista = pre.decode().catch(() => {});
        Promise.race([lista, new Promise((r) => setTimeout(r, 260))]).then(() => {
          transicion(
            () => {
              // visible y abierto en el mismo cuadro: sin el fundido propio del
              // visor, la entrada la hace la transición
              lbox!.classList.add('is-open');
              abrirVisor(i);
              panel?.focus({ preventScroll: true });
            },
            desde,
            () => visor,
          );
        });
        return;
      }
      abrirVisor(i);
      // un frame de margen para que la transición de entrada se vea
      requestAnimationFrame(() => lbox!.classList.add('is-open'));
      panel?.focus();
    }

    function close() {
      if (vtCorriendo) return;
      const destino = items[cur];
      const ocultar = () => {
        lbox!.hidden = true;
        visor?.removeAttribute('src');
      };
      if (conVT() && destino) {
        const vuelve = miniaturaALaVista(destino);
        transicion(
          () => {
            lbox!.classList.remove('is-open');
            root.classList.remove('gal-open');
            ocultar();
          },
          visor,
          () => (vuelve ? destino : null),
        );
      } else {
        lbox!.classList.remove('is-open');
        root.classList.remove('gal-open');
        if (reduce.matches) ocultar();
        else hideTimer = window.setTimeout(ocultar, 260);
      }
      opener?.focus({ preventScroll: true });
      opener = null;
    }

    // ---- abrir desde la tira -------------------------------------------------
    items.forEach((a, i) => {
      a.addEventListener('click', (e) => {
        // ctrl/cmd/shift o botón del medio → dejar que el navegador abra la
        // foto en una pestaña nueva, que es lo que el usuario está pidiendo
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        if (arrastrado) return; // veníamos arrastrando la tira, no es un click
        open(i, a);
      });
    });

    lbox.querySelectorAll('[data-gal-close]').forEach((b) => b.addEventListener('click', close));
    lbox.querySelector('[data-gal-prev]')?.addEventListener('click', () => show(cur - 1));
    lbox.querySelector('[data-gal-next]')?.addEventListener('click', () => show(cur + 1));

    document.addEventListener('keydown', (e) => {
      if (lbox!.hidden) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(cur - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(cur + 1);
      } else if (e.key === 'Tab') {
        // el foco no se escapa del visor mientras está abierto
        const f = Array.from(lbox!.querySelectorAll<HTMLElement>('button'));
        if (!f.length) return;
        const primero = f[0];
        const ultimo = f[f.length - 1];
        const activo = document.activeElement;
        if (e.shiftKey && (activo === primero || activo === panel)) {
          e.preventDefault();
          ultimo.focus();
        } else if (!e.shiftKey && activo === ultimo) {
          e.preventDefault();
          primero.focus();
        }
      }
    });

    // ---- tira: arrastrar con el mouse ---------------------------------------
    // El scroll horizontal nativo cubre trackpad, touch y la barra; con mouse a
    // secas arrastrar es lo natural. Umbral de 5px para no comerse el click.
    let arrastrado = false;
    let apretado = false;
    let x0 = 0;
    let scroll0 = 0;

    strip.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      apretado = true;
      arrastrado = false;
      x0 = e.clientX;
      scroll0 = strip.scrollLeft;
    });
    strip.addEventListener('pointermove', (e) => {
      if (!apretado) return;
      const dx = e.clientX - x0;
      if (!arrastrado && Math.abs(dx) > 5) {
        arrastrado = true;
        strip.classList.add('is-dragging');
      }
      if (arrastrado) strip.scrollLeft = scroll0 - dx;
    });
    const soltar = () => {
      if (!apretado) return;
      apretado = false;
      strip.classList.remove('is-dragging');
      // el `click` posterior corre ANTES que este timer → todavía ve arrastrado
      // en true y no abre el visor; recién después se limpia.
      setTimeout(() => {
        arrastrado = false;
      }, 0);
    };
    strip.addEventListener('pointerup', soltar);
    strip.addEventListener('pointerleave', soltar);
    strip.addEventListener('pointercancel', soltar);
    // sin esto el navegador arranca su propio arrastre de imagen/link
    strip.addEventListener('dragstart', (e) => e.preventDefault());

    // ---- flechitas de los extremos ------------------------------------------
    // Desplazan ~3/4 de lo que se ve, para que quede algo de contexto en cuadro.
    wrap?.querySelectorAll<HTMLButtonElement>('[data-gal-scroll]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.dataset.galScroll) || 1;
        strip.scrollBy({
          left: dir * strip.clientWidth * 0.75,
          behavior: reduce.matches ? 'auto' : 'smooth',
        });
      });
    });

    // ---- degradés de borde: sólo si hay algo más para ver --------------------
    const bordes = () => {
      if (!wrap) return;
      const max = strip.scrollWidth - strip.clientWidth;
      wrap.classList.toggle('has-overflow', max > 2);
      wrap.classList.toggle('at-start', strip.scrollLeft <= 2);
      wrap.classList.toggle('at-end', strip.scrollLeft >= max - 2);
    };
    strip.addEventListener('scroll', bordes, { passive: true });
    window.addEventListener('resize', bordes, { passive: true });
    bordes();
  }
</script>
