---
import { site } from '../data/site';
// (El preload de fuentes vive en BaseLayout: TODOS los woff2 se precargan ahí,
// junto a sus @font-face con font-display:block — sin frame de fuente fallback.)

interface Props {
  title: string;
  description: string;
  /** Ruta o URL de la imagen para compartir. Por defecto, la del sitio. */
  image?: string;
  /** JSON-LD adicional para esta página (ej. el proyecto). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image = site.ogImage, jsonLd } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

// JSON-LD base: Organization + LocalBusiness con la dirección real.
const business = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  name: site.nombre,
  legalName: site.nombreLargo,
  description: site.descripcion,
  email: site.email,
  url: Astro.site?.href,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.direccion.calle,
    addressLocality: site.direccion.ciudad,
    addressCountry: site.direccion.paisISO,
  },
  areaServed: 'Montevideo, Uruguay',
  ...(site.telefono ? { telephone: site.telefono } : {}),
  ...(site.instagram ? { sameAs: [site.instagram] } : {}),
};

const jsonLdBlocks = [business, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<!-- color del chrome del navegador en mobile (barra de direcciones) = papel del sitio -->
<meta name="theme-color" content="#EAE8E2" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.nombre} />
<meta property="og:locale" content="es_UY" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Iconos -->
<link rel="icon" type="image/png" sizes="512x512" href={`${base}/favicon.png`} />
<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

<link rel="sitemap" href={`${base}/sitemap-index.xml`} />

<!-- JSON-LD -->
{jsonLdBlocks.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
