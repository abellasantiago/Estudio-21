---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { getPortada } from '../lib/images';
import '../styles/header.css';
import banner from '../assets/marca/banner_negro.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/*
 * "Proyectos" abre un desplegable con los tres estados y, dentro de cada uno, la
 * lista de sus proyectos (submenú anidado) para entrar directo a la ficha.
 * Mismo orden editorial que la sección de proyectos: primero lo activo hoy,
 * después lo que viene y al final el track record; dentro de cada grupo, por año
 * descendente.
 */
const proyectos = await getCollection('proyectos');
const grupos = (
  [
    { estado: 'en-proceso', label: 'En proceso' },
    { estado: 'proximamente', label: 'Próximamente' },
    { estado: 'terminado', label: 'Terminados' },
  ] as const
).map((g) => ({
  ...g,
  items: proyectos
    .filter((p) => p.data.estado === g.estado)
    .sort((a, b) => b.data.anio - a.data.anio)
    .map((p) => ({ ...p.data, portada: getPortada(p.data.slug) })),
}));

// chip de la vista previa: mismo texto que en las cards y en la ficha
const estadoLabels = {
  proximamente: 'Próximamente',
  'en-proceso': 'En proceso',
  terminado: 'Terminado',
} as const;

// Ancho de la foto de la vista previa en px CSS. ⚠ Tiene que coincidir con
// --prev-foto-w en header.css: con eso se piden justo la versión 1× y la 2×.
const PREV_FOTO_W = 208;
---

<header id="header">
  <div class="nav">
    <a href={`${base}/`} class="brand" aria-label="Estudio 21 Arquitectos — inicio">
      {/* El lockup se muestra a 111px de ancho (`.mark-img` lo topa en
          `height:2rem` y el ancho sale de su proporción, 3.456). Antes se pedía
          a `width={864}` —el ancho del PNG— y el build servía esos 864px: 35 KB
          para pintar 111, en CADA página del sitio. Ahora son 4,1 KB en 1× y
          12 KB en 2×.
          Va con `densities` y no con `widths`/`sizes` porque la medida en
          pantalla es FIJA: así el srcset sale con descriptores 2x/3x y el `src`
          de respaldo es el de 111px. Con `widths` el respaldo salía al ancho
          del PNG y el build emitía igual el archivo de 864px (38 KB) en cada
          página, aunque ningún navegador con srcset lo pida.
          La calidad va en 90 y no en el default: es un grafismo de dos tonos
          con bordes duros, y el logo del estudio no es el lugar para ahorrar
          los 2 KB que separan 80 de 90. */}
      <Image
        src={banner}
        alt="Estudio 21 Arquitectos"
        width={111}
        height={32}
        densities={[2, 3]}
        quality={90}
        loading="eager"
        class="mark-img"
      />
    </a>
    <nav class="nav-links" id="menu" aria-label="Navegación principal">
      <a href={`${base}/`}>Inicio</a>
      <a href={`${base}/#nosotros`}>Nosotros</a>

      <div class="nav-item" data-nav-menu>
        <a href={`${base}/#proyectos`} class="nav-trigger" aria-haspopup="true" aria-expanded="false">
          Proyectos
          <svg class="nav-caret" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1 1.4 5 5 9 1.4" />
          </svg>
        </a>

        <div class="nav-menu">
          <ul class="nav-menu-list">
            {grupos.map((g) => (
              <li class="nav-sub" data-nav-sub>
                <button type="button" class="nav-sub-btn" aria-expanded="false" disabled={g.items.length === 0}>
                  <span class="nav-sub-label">{g.label}</span>
                  <svg class="nav-caret nav-caret-side" viewBox="0 0 6 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1.4 1 5 5l-3.6 4" />
                  </svg>
                </button>

                {g.items.length > 0 && (
                  <div class="nav-flyout">
                    <ul>
                      {g.items.map((p) => (
                        <li>
                          <a href={`${base}/proyectos/${p.slug}/`} class="nav-proj" data-slug={p.slug}>
                            <span class="nav-proj-name">{p.nombre}</span>
                            <span class="nav-proj-anio">{p.anio}</span>
                            {/* Vista previa (sólo desktop con mouse, ver header.css):
                                va ADENTRO del link para que pasar el mouse por la
                                foto siga contando como estar sobre el proyecto, y
                                un click en ella también entre a la ficha. Es
                                decorativa para el lector de pantalla: el nombre
                                del link ya lo dice todo. */}
                            <span class="nav-prev" aria-hidden="true">
                              <span class="nav-prev-foto">
                                {p.portada ? (
                                  <Image
                                    src={p.portada}
                                    alt=""
                                    widths={[PREV_FOTO_W, PREV_FOTO_W * 2]}
                                    sizes={`${PREV_FOTO_W}px`}
                                    quality={80}
                                    style={`--pf:${p.portadaFoco ?? '50% 50%'};--pz:${p.portadaZoom ?? 1}`}
                                  />
                                ) : (
                                  <span class="nav-prev-ph">imagen pendiente</span>
                                )}
                              </span>
                              <span class="nav-prev-pie">
                                <span class={`status ${p.estado}`}><span class="pip"></span>{estadoLabels[p.estado]}</span>
                                <span class="nav-prev-loc">{p.barrio ?? p.ubicacion}</span>
                              </span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <a href={`${base}/#estudio`}>Equipo</a>
      <a class="nav-contacto" href={`${base}/#contacto`}>Contacto</a>
    </nav>
    <button
      class="burger"
      id="burger"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  /*
   * Capa de mejora del desplegable de "Proyectos".
   * Sin JS ya funciona: la CSS lo abre con :hover y con :focus-within (o sea que
   * también se recorre con el teclado). Acá se agrega lo que la CSS no puede:
   *   · modo tap (mobile / punteros gruesos): el link no navega, despliega.
   *   · de qué lado abre el submenú, según el lugar que quede en pantalla.
   *   · cierre completo al salir, Escape y click afuera; aria sincronizado.
   */
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-menu]'));

  for (const item of items) {
    const trigger = item.querySelector<HTMLAnchorElement>('.nav-trigger');
    const menu = item.querySelector<HTMLElement>('.nav-menu');
    const subs = Array.from(item.querySelectorAll<HTMLElement>('[data-nav-sub]'));
    if (!trigger || !menu) continue;

    // punteros sin hover (o el menú hamburguesa) → el desplegable abre con tap
    const tapMode = () => window.matchMedia('(max-width: 760px), (hover: none)').matches;
    const setExpanded = (v: boolean) => trigger.setAttribute('aria-expanded', String(v));
    const limpiarPreviews = new Map<HTMLElement, () => void>();

    function closeSub(sub: HTMLElement) {
      sub.classList.remove('is-open');
      sub.querySelector('.nav-sub-btn')?.setAttribute('aria-expanded', 'false');
      limpiarPreviews.get(sub)?.();
    }
    function closeSubs() {
      for (const sub of subs) closeSub(sub);
    }
    function close() {
      item.classList.remove('is-open');
      setExpanded(false);
      closeSubs();
    }

    /* El submenú abre a la DERECHA del panel salvo que no entre en pantalla: como
       "Proyectos" cae en la mitad derecha del navbar, en la práctica casi siempre
       sale hacia la izquierda. La vista previa cuelga del lado de afuera del
       submenú, así que se busca un lado donde entren LOS DOS; si en ninguno
       entran (ventanas angostas) el submenú va donde quepa y la vista previa no
       se muestra. Se mide con todo oculto (visibility:hidden conserva la caja,
       así que los anchos son reales). */
    const flyouts = Array.from(item.querySelectorAll<HTMLElement>('.nav-flyout'));
    const prevEj = item.querySelector<HTMLElement>('.nav-prev');
    function placeFlyout() {
      item.classList.remove('flyout-left', 'sin-preview');
      if (tapMode() || !flyouts.length) return;
      const margen = 12;
      const r = menu!.getBoundingClientRect();
      const flyW = Math.max(...flyouts.map((f) => f.offsetWidth));
      const prevW = prevEj?.offsetWidth ?? 0; // 0 si la vista previa no aplica (sin mouse)
      const lugarDer = window.innerWidth - margen - r.right;
      const lugarIzq = r.left - margen;
      if (lugarDer >= flyW + prevW) return;
      if (lugarIzq >= flyW + prevW) item.classList.add('flyout-left');
      else if (lugarDer >= flyW) item.classList.add('sin-preview');
      else item.classList.add('flyout-left', 'sin-preview');
    }

    /* Vista previa: el proyecto "activo" es el último que tocó el mouse (o el
       foco), no sólo el que está bajo el cursor. Así la foto no parpadea al
       cruzar el margen del submenú ni al ir con el mouse hasta ella, y el
       fundido siempre es de un proyecto a otro. Sin JS la CSS lo resuelve con
       :hover (ver `.nav-flyout:not(.js-prev)` en header.css). */
    for (const fly of flyouts) {
      fly.classList.add('js-prev');
      const links = Array.from(fly.querySelectorAll<HTMLAnchorElement>('.nav-proj'));
      let pendiente = 0;
      const activar = (a: HTMLAnchorElement) => {
        clearTimeout(pendiente);
        for (const l of links) l.classList.toggle('is-prev', l === a);
        fly.classList.add('tiene-prev');
      };
      const limpiar = () => {
        clearTimeout(pendiente);
        fly.classList.remove('tiene-prev');
        for (const l of links) l.classList.remove('is-prev');
        rastro.length = 0;
        ultimoMov = 0;
      };

      /* "Puntería" hacia la foto: quien va con el mouse hasta la vista previa
         casi nunca se mueve en horizontal, baja o sube en diagonal y en el
         camino pasa por encima de otros proyectos. Si cada uno se activara al
         instante, la foto cambiaría justo mientras uno va a mirarla. Mientras
         el movimiento apunte a la foto (el puntero entra en el triángulo que
         forman su posición de hace unos eventos y el borde cercano de la
         vista previa), el cambio espera un instante; si el mouse se queda
         quieto sobre el proyecto nuevo, se activa igual. */
      const rastro: { x: number; y: number }[] = [];
      let ultimoMov = 0;
      fly.addEventListener('pointermove', (e) => {
        rastro.push({ x: e.clientX, y: e.clientY });
        if (rastro.length > 4) rastro.shift();
        ultimoMov = performance.now();
      });
      const apuntaALaFoto = () => {
        const activa = fly.querySelector<HTMLElement>('.nav-proj.is-prev .nav-prev');
        if (!activa || rastro.length < 2) return false;
        const r = activa.getBoundingClientRect();
        if (!r.width) return false;
        const p0 = rastro[0];
        const p1 = rastro[rastro.length - 1];
        const bx = item.classList.contains('flyout-left') ? r.right : r.left;
        // ¿p1 cae dentro del triángulo (p0, borde de arriba, borde de abajo)?
        const lado = (ax: number, ay: number, cx: number, cy: number, px: number, py: number) =>
          (cx - ax) * (py - ay) - (cy - ay) * (px - ax);
        const d1 = lado(p0.x, p0.y, bx, r.top - 20, p1.x, p1.y);
        const d2 = lado(bx, r.top - 20, bx, r.bottom + 20, p1.x, p1.y);
        const d3 = lado(bx, r.bottom + 20, p0.x, p0.y, p1.x, p1.y);
        const neg = d1 < 0 || d2 < 0 || d3 < 0;
        const pos = d1 > 0 || d2 > 0 || d3 > 0;
        return !(neg && pos) && Math.hypot(p1.x - p0.x, p1.y - p0.y) > 2;
      };
      for (const a of links) {
        // mientras siga en viaje hacia la foto se sigue esperando; en cuanto el
        // mouse se frena sobre este proyecto, pasa a ser el activo
        const intentar = () => {
          if (!a.matches(':hover')) return;
          if (performance.now() - ultimoMov < 90 && apuntaALaFoto()) {
            pendiente = window.setTimeout(intentar, 90);
            return;
          }
          activar(a);
        };
        a.addEventListener('pointerenter', () => {
          if (a.classList.contains('is-prev')) return activar(a);
          if (!fly.classList.contains('tiene-prev') || !apuntaALaFoto()) return activar(a);
          clearTimeout(pendiente);
          pendiente = window.setTimeout(intentar, 140);
        });
        a.addEventListener('focus', () => activar(a));
      }
      // Cerrar también borra el proyecto activo, los timers y el rastro del
      // puntero. Ninguna foto de la visita anterior queda esperando oculta.
      const sub = fly.parentElement!;
      limpiarPreviews.set(sub, limpiar);
      sub?.querySelector('.nav-sub-btn')?.addEventListener('focus', limpiar);
    }

    // --- abrir/cerrar ---------------------------------------------------------
    trigger.addEventListener('click', (e) => {
      if (!tapMode()) return; // en desktop ya abrió por hover: el link navega
      e.preventDefault();
      if (item.classList.contains('is-open')) close();
      else {
        item.classList.add('is-open');
        setExpanded(true);
      }
    });

    for (const sub of subs) {
      const btn = sub.querySelector<HTMLButtonElement>('.nav-sub-btn');
      if (!btn || btn.disabled) continue;
      const openSub = () => {
        for (const other of subs) if (other !== sub) closeSub(other);
        sub.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      };
      sub.addEventListener('pointerenter', () => {
        if (!tapMode()) openSub();
      });
      sub.addEventListener('pointerleave', () => {
        if (tapMode()) return;
        const focused = document.activeElement;
        if (focused && sub.contains(focused) && focused.matches(':focus-visible')) return;
        closeSub(sub);
      });
      sub.addEventListener('focusin', () => {
        if (!tapMode()) openSub();
      });
      sub.addEventListener('focusout', (e) => {
        if (sub.contains(e.relatedTarget as Node)) return;
        if (!tapMode() && sub.matches(':hover')) return;
        closeSub(sub);
      });
      btn.addEventListener('click', () => {
        if (!tapMode()) return openSub();
        const abierto = sub.classList.contains('is-open');
        closeSubs();
        if (!abierto) openSub();
      });
    }

    // --- sincronizar aria + lado del submenú con lo que hace la CSS -----------
    item.addEventListener('pointerenter', () => {
      if (tapMode()) return;
      // las fotos de la vista previa recién se piden al abrir el menú por
      // primera vez (hasta entonces van con display:none y el lazy-load no las
      // baja): son unos KB que no tiene sentido cargar en cada página
      item.classList.add('prev-lista');
      placeFlyout();
      item.classList.add('is-open');
      setExpanded(true);
    });
    item.addEventListener('pointerleave', () => {
      if (tapMode()) return;
      const focused = document.activeElement;
      // El teclado puede seguir recorriendo el menú aunque el mouse se vaya.
      // Un foco dejado por un click, en cambio, no lo mantiene abierto.
      if (focused && item.contains(focused) && focused.matches(':focus-visible')) return;
      close();
      if (focused instanceof HTMLElement && item.contains(focused)) focused.blur();
    });
    item.addEventListener('focusin', () => {
      item.classList.add('prev-lista');
      placeFlyout();
      if (tapMode()) return;
      item.classList.add('is-open');
      setExpanded(true);
    });
    item.addEventListener('focusout', (e) => {
      if (item.contains(e.relatedTarget as Node)) return;
      if (!tapMode() && item.matches(':hover')) return;
      close();
    });

    item.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      trigger.focus();
      close(); // después del foco: focusin no debe volver a abrirlo
    });

    window.addEventListener(
      'resize',
      () => {
        placeFlyout();
        if (!tapMode()) close(); // pasar de menú hamburguesa a navbar: arrancar limpio
      },
      { passive: true },
    );

    document.addEventListener('click', (e) => {
      if (!item.contains(e.target as Node)) close();
    });

    // Con JS, sólo .is-open habilita los paneles y su hit testing. Los :hover
    // quedan como fallback sin JS; así un descendiente oculto no los revive.
    item.classList.add('js-nav');
    placeFlyout();
  }
</script>
