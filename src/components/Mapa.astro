---
/*
 * Mapa de situación de la ficha de proyecto.
 *
 * El SVG se arma en el build (src/lib/mapa/lamina.ts) y viaja INLINE en el
 * HTML. Es lo contrario de lo que se hace con la axonometría de la home, que
 * se pide aparte, y la diferencia son los números: la axonometría pesa 27 KB
 * gzip, va en la página que recibe a todo el mundo y en mobile ni se ve; el
 * mapa pesa un tercio de eso, va en una ficha que se abre de a una y en un
 * teléfono se ve igual que en un escritorio. Inline además lo pinta junto con
 * la página (sin salto), le deja usar la tipografía y los tokens del sitio, y
 * anda sin JS.
 */
import { mapaSVG } from '../lib/mapa/lamina.ts';
import '../styles/mapa.css';

interface Props {
  coords: [number, number];
  barrio: string;
  direccion?: string;
  ubicacion: string;
  /* Link de la consulta por esta obra. Va en la cartela, bajo el barrio: ese
     hueco estaba vacío y es el único lugar de la ficha donde hay aire para una
     acción sin inventar un bloque nuevo. ⚠ Si un proyecto no tiene `coords` no
     hay mapa, y entonces tampoco hay botón: ver ProjectLayout. */
  consultaHref?: string;
}

const { coords, barrio, direccion, ubicacion, consultaHref } = Astro.props;
const svg = mapaSVG({ lon: coords[0], lat: coords[1], barrio });
---

<section class="proj-ubic" aria-labelledby="ubic-tit">
  <div class="ubic-mapa" set:html={svg} />

  {/* Pie del plano: nada más que el dato. La coordenada en grados y el crédito
      de las fuentes estuvieron acá y se sacaron (2026-11-06) — eran dos
      cartelitos de letra chica que ensuciaban la ficha. El crédito, que la
      licencia de OSM sí exige, pasó al footer del sitio. */}
  <div class="ubic-datos">
    <p class="eyebrow" id="ubic-tit">Ubicación</p>
    {direccion && <p class="ubic-dir">{direccion}</p>}
    <p class="ubic-zona">{barrio} · {ubicacion}</p>
    {consultaHref && (
      <a
        class="btn btn--primary ubic-cta"
        href={consultaHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>Quiero información sobre este proyecto</span>
        <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    )}
  </div>
</section>
