---
/*
 * Mapa de situación de la ficha de proyecto.
 *
 * El SVG se arma en el build (src/lib/mapa/lamina.ts) y viaja INLINE en el
 * HTML. Es lo contrario de lo que se hace con la axonometría de la home, que
 * se pide aparte, y la diferencia son los números: la axonometría pesa 27 KB
 * gzip, va en la página que recibe a todo el mundo y en mobile ni se ve; el
 * mapa pesa un tercio de eso, va en una ficha que se abre de a una y en un
 * teléfono se ve igual que en un escritorio. Inline además lo pinta junto con
 * la página (sin salto), le deja usar la tipografía y los tokens del sitio, y
 * anda sin JS.
 */
import { mapaSVG } from '../lib/mapa/lamina.ts';
import '../styles/mapa.css';

interface Props {
  coords: [number, number];
  barrio: string;
  direccion?: string;
  ubicacion: string;
}

const { coords, barrio, direccion, ubicacion } = Astro.props;
const [lon, lat] = coords;
const svg = mapaSVG({ lon, lat, barrio });

/* Las coordenadas en grados/minutos/segundos. No son para que nadie las copie:
   son la marca de que el plano está levantado sobre un punto real y no es una
   ilustración — el mismo papel que cumplen el norte y la escala gráfica. */
function gms(valor: number, positivo: string, negativo: string) {
  const g = Math.abs(valor);
  const grados = Math.floor(g);
  const minutos = Math.floor((g - grados) * 60);
  const segundos = Math.round((g - grados - minutos / 60) * 3600);
  const dd = String(segundos === 60 ? minutos + 1 : minutos).padStart(2, '0');
  const ss = String(segundos === 60 ? 0 : segundos).padStart(2, '0');
  return `${grados}°${dd}′${ss}″ ${valor < 0 ? negativo : positivo}`;
}
const coordenadas = `${gms(lat, 'N', 'S')} · ${gms(lon, 'E', 'O')}`;
---

<section class="proj-ubic" aria-labelledby="ubic-tit">
  <div class="ubic-mapa" set:html={svg} />

  <div class="ubic-datos">
    <div>
      <p class="eyebrow" id="ubic-tit">Ubicación</p>
      {direccion && <p class="ubic-dir">{direccion}</p>}
      <p class="ubic-zona">{barrio} · {ubicacion}</p>
    </div>

    <div class="ubic-pie">
      <p class="ubic-coord">{coordenadas}</p>

      {/* ODbL pide el crédito; de paso aclara que el plano es propio y no una
          captura de un servicio de mapas */}
      <p class="ubic-fuente">
        Plano propio. Costa y viario:{' '}
        <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer"
          >© OpenStreetMap</a
        >, ODbL. Barrios: Intendencia de Montevideo, datos abiertos.
      </p>
    </div>
  </div>
</section>
