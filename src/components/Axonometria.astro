---
/*
 * Axonometria — la columna gráfica de "Quiénes somos".
 *
 * Una axonometría seccionada (casa de dos plantas con corte de esquina) que se
 * DIBUJA con el scroll, trazo a trazo y por etapas de obra:
 *   terreno → planta baja → losa y planta alta → cubierta y pérgola →
 *   equipamiento → sombras, vegetación y figuras.
 * El dibujo sale de una escena 3D resuelta en build (src/lib/axonometria/).
 *
 * ⚠ El SVG NO viaja en el HTML. Se sirve como archivo (/axonometria.svg, ver
 * src/pages/axonometria.svg.ts) y este componente lo trae con fetch SÓLO cuando
 * hay dos columnas (≥900px), que es donde se ve. Son ~120 KB (~27 KB gzip) que
 * antes bajaba todo el mundo: en mobile la columna va `display:none`, así que
 * cada teléfono se descargaba el 55% del HTML de la home para nada.
 *
 * Cómo se anima (axonometria.css):
 *   · con scroll-driven animations (Chrome/Edge, Safari 26+): atada al scroll
 *     con `view-timeline` → al subir se desarma;
 *   · sin eso: se dibuja sola, por tiempo, cuando entra en pantalla (script);
 *   · con prefers-reduced-motion: está completa desde el principio.
 * Sin JS no hay dibujo (no hay quién lo pida): ahí la columna no se reserva
 * —`html:not(.js)` en presentacion.css— y la sección queda a una columna, igual
 * que en mobile.
 */
import '../styles/axonometria.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="axo-lamina" data-axo data-axo-src={`${base}/axonometria.svg`}></div>

<script>
  /*
   * Trae la lámina y la dibuja. El fetch arranca recién si el dibujo se va a
   * ver: por debajo de 900px la columna está oculta y no hay nada que pedir.
   * Se queda escuchando la media query para el caso de agrandar la ventana.
   */
  const lamina = document.querySelector<HTMLElement>('[data-axo]');
  const src = lamina?.dataset.axoSrc;

  if (lamina && src) {
    const dosColumnas = window.matchMedia('(min-width: 901px)');
    let pedida = false;

    const animar = () => {
      // Plan B para navegadores sin scroll-driven animations: la lámina se
      // dibuja por tiempo la primera vez que entra en pantalla. Con soporte, lo
      // resuelve la CSS sola (atada al scroll) y esto no hace nada.
      const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const conScroll = typeof CSS !== 'undefined' && CSS.supports('animation-timeline: view()');
      if (quieto || conScroll || !('IntersectionObserver' in window)) return;

      lamina.classList.add('axo-pendiente');
      const io = new IntersectionObserver(
        (entradas) => {
          if (!entradas.some((e) => e.isIntersecting)) return;
          lamina.classList.add('axo-dibujando');
          io.disconnect();
        },
        { threshold: 0.3 },
      );
      io.observe(lamina);
    };

    const traer = () => {
      if (pedida || !dosColumnas.matches) return;
      pedida = true;
      fetch(src)
        .then((r) => (r.ok ? r.text() : Promise.reject(new Error(String(r.status)))))
        .then((svg) => {
          lamina.innerHTML = svg;
          animar();
        })
        .catch(() => {
          // Sin lámina la sección se lee igual: el texto es el contenido. Se
          // deja reintentar por si fue un corte de red momentáneo.
          pedida = false;
        });
    };

    traer();
    dosColumnas.addEventListener('change', traer);
  }
</script>
