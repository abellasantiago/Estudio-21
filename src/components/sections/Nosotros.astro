---
import '../../styles/nosotros.css';

const fases = [
  {
    pf: 'Originación',
    h: 'Detectamos la oportunidad',
    p: 'Identificamos la zona, conseguimos el terreno y validamos el negocio.',
  },
  {
    pf: 'Estructura',
    h: 'Reunimos la inversión',
    p: 'Damos forma al capital, proyecto por proyecto, con reglas claras.',
  },
  {
    pf: 'Proyecto y obra',
    h: 'Diseñamos y construimos',
    p: 'Arquitectura y dirección de obra con equipo propio.',
  },
  {
    pf: 'Entrega y venta',
    h: 'Entregamos cada unidad',
    p: 'Acompañamos la obra hasta la escritura y la colocación de las unidades.',
  },
];
---

{/* El ancla `#nosotros` la tiene Presentacion.astro: al hacer click en
    "Nosotros" se entra por la presentación del estudio. Esta sección va DESPUÉS
    de Proyectos (el proceso, una vez vista la obra) y no lleva fondo propio:
    va sobre el papel abierto, entre la mesa de Proyectos (un punto más honda)
    y el papel claro de Equipo, así se despega de las dos. Con el `--paper-2`
    de `.alt` quedaba pegada a Equipo, que tiene ese tono, y las dos se leían
    como un solo bloque. */}
<section class="block" id="como-operamos">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow reveal">Cómo operamos</span>
      <h2 class="section-title reveal" data-d="1">Desarrollamos, no solo proyectamos.</h2>
      <p class="lead reveal" data-d="2">
        Encontramos el terreno, reunimos a los inversores y nos hacemos cargo
        del ciclo completo —diseño, obra y venta— con un equipo chico,
        comprometido y profesional. Cuando el inmueble es de un tercero,
        asumimos el mismo recorrido para él.
      </p>
    </div>

    <div class="phases" data-depth="0.14">
      {fases.map((f, i) => (
        <div class="phase reveal" data-d={i + 1}>
          <div class="pf"><span class="pf-n">{i + 1}</span> · {f.pf}</div>
          <h3>{f.h}</h3>
          <p>{f.p}</p>
        </div>
      ))}
    </div>
  </div>
</section>
