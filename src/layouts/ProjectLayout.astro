---
import { Picture, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Galeria from '../components/Galeria.astro';
import { getPortada, getGaleria } from '../lib/images';
import { site } from '../data/site';
import '../styles/project-page.css';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
}

const { proyecto } = Astro.props;
const {
  nombre,
  slug,
  estado,
  ubicacion,
  barrio,
  anio,
  unidades,
  metros,
  portadaFoco,
  portadaZoom,
  portadaAspecto,
} = proyecto.data;

const { Content } = await render(proyecto);
const portada = getPortada(slug);
const galeria = getGaleria(slug);
const estadoLabels = {
  proximamente: 'Próximamente',
  'en-proceso': 'En proceso',
  terminado: 'Terminado',
} as const;
const estadoLabel = estadoLabels[estado];
// Frase para la meta-descripción (que lea natural en cada estado).
const estadoFrase = {
  proximamente: 'próximo proyecto',
  'en-proceso': 'proyecto en proceso',
  terminado: 'proyecto terminado',
}[estado];

// Imagen OG de la página: la portada del proyecto si existe; si no, la del sitio.
const ogImage = portada
  ? (await getImage({ src: portada, width: 1200, format: 'jpg' })).src
  : undefined;

const title = `${nombre} — Estudio 21`;
const description = `${nombre}: ${estadoFrase} de Estudio 21 en ${
  barrio ? `${barrio}, ` : ''
}${ubicacion} (${anio}).`;

const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Residence',
  name: nombre,
  url,
  address: {
    '@type': 'PostalAddress',
    addressLocality: ubicacion,
    addressCountry: site.direccion.paisISO,
  },
};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/*
 * Ancho REAL que el navegador tiene que rasterizar de la portada.
 * Lo que manda es el ALTO de la caja, topado en COVER_H_MAX (ver --cover-h en
 * .proj-cover, project-page.css: el ancho de la columna se DERIVA de ese alto
 * fijo según la proporción de cada portada — no al revés). Con
 * `object-fit:cover`, el navegador escala la foto hasta que su lado más
 * exigente llena la caja: si la foto es más ancha que la caja (proporción >
 * coverBoxAr) manda el ALTO y el ancho renderizado = COVER_H_MAX × proporción
 * de la foto; si es más angosta, manda el ANCHO de la caja. Las dos se cubren
 * con `COVER_H_MAX × max(coverBoxAr, coverAr)`. Villa Platero (1.50) necesita
 * 840px — pidiéndole menos el navegador la estiraba y salía blanda. El zoom
 * manual (`portadaZoom`) multiplica sobre eso.
 * ⚠ COVER_AR_DEFAULT debe coincidir con el fallback del `aspect-ratio` de
 * `.proj-cover` en project-page.css, y COVER_H_MAX con su `--cover-h` — si se
 * cambia uno hay que cambiar el otro.
 */
const COVER_W = 480; // ancho de la caja cuando está en 6/7 (su ancho de referencia)
const COVER_AR_DEFAULT = 6 / 7; // proporción por defecto de la caja de la portada
const COVER_H_MAX = COVER_W / COVER_AR_DEFAULT; // 560 — alto MÁXIMO de la caja (fijo, igual en todos los proyectos)
const coverBoxAr = portadaAspecto
  ? (([w, h]) => w / h)(portadaAspecto.split('/').map(Number))
  : COVER_AR_DEFAULT;
const coverAr = portada ? portada.width / portada.height : coverBoxAr;
const coverRender = Math.round(COVER_H_MAX * Math.max(coverBoxAr, coverAr) * (portadaZoom ?? 1));
const coverWidths = portada
  ? [...new Set([coverRender, Math.min(coverRender * 2, portada.width)])].sort((a, b) => a - b)
  : [COVER_W];

const ficha = [
  { k: 'Estado', v: estadoLabel, pendiente: false, loc: false },
  { k: 'Año', v: String(anio), pendiente: false, loc: false },
  { k: 'Ubicación', v: barrio ?? ubicacion, pendiente: false, loc: true },
  { k: 'Unidades', v: unidades != null ? String(unidades) : 'Pendiente', pendiente: unidades == null, loc: false },
  { k: 'm²', v: metros != null ? String(metros) : 'Pendiente', pendiente: metros == null, loc: false },
];
---

<BaseLayout title={title} description={description} image={ogImage} jsonLd={jsonLd}>
  <article class="proj-hero">
    <div class="wrap">
      <a class="back-link" href={`${base}/#proyectos`}>Volver a proyectos</a>

      <div class="proj-head">
        <h1 class="proj-title">{nombre}</h1>
        <span class={`status ${estado}`}><span class="pip"></span>{estadoLabel}</span>
      </div>

      {/* Portada a la izquierda, descripción al costado. La portada va en 6/7
          (vertical suave) por defecto, igual en la mayoría de los proyectos:
          el encuadre de cada una se ajusta con `portadaFoco` / `portadaZoom`
          del frontmatter. La proporción de la caja en sí también se puede
          overridear por proyecto con `portadaAspecto` (ej. Patios del
          Regimiento, muy apaisada: el 6/7 le recortaba demasiado). */}
      <div class="proj-top">
        {portada ? (
          <div class="proj-cover" style={`--cover-ar:${portadaAspecto ?? '6/7'}`}>
            <Picture
              src={portada}
              formats={['avif', 'webp']}
              alt={`Portada del proyecto ${nombre}`}
              widths={coverWidths}
              sizes={`${coverRender}px`}
              style={`--pf:${portadaFoco ?? '50% 50%'};--pz:${portadaZoom ?? 1}`}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        ) : (
          <div class="proj-cover is-placeholder">
            <span class="cover-ph">imagen pendiente</span>
          </div>
        )}

        <!-- descripción -->
        <div class="proj-desc">
          <Content />
        </div>
      </div>

      <!-- ficha técnica -->
      <dl class="ficha">
        {ficha.map((c) => (
          <div class="cell">
            <dt class="fk">{c.k}</dt>
            <dd class={`fv${c.pendiente ? ' pendiente' : ''}${c.loc ? ' fv-loc' : ''}`}>{c.v}</dd>
          </div>
        ))}
      </dl>

      <Galeria fotos={galeria} nombre={nombre} slug={slug} />
    </div>
  </article>
</BaseLayout>
